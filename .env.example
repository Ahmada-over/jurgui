# Jur-gui — Environnement de Configuration
PROJECT_NAME="Jur-gui — Élevage Intelligent Dakar"
VERSION=1.0.0
API_V1_STR=/api/v1

# Sécurité JWT
SECRET_KEY=change-this-super-secret-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de données
# Mode développement local / test :
DATABASE_URL=sqlite+aiosqlite:///./jurgui.db
# Mode production PostgreSQL :
# DATABASE_URL=postgresql+asyncpg://jurgui:jurgui_secret_2026@localhost:5432/jurgui_db

# Paramètres métiers
DEFAULT_GESTATION_DAYS=150
DEFAULT_CURRENCY=FCFA
