# Jur-gui — Environnement de Configuration
# Copier ce fichier: cp .env.example .env
PROJECT_NAME="Jur-gui — Élevage Intelligent Dakar"
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment: development | staging | production
ENVIRONMENT=development

# Sécurité JWT
SECRET_KEY=change-this-super-secret-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Base de données (Neon PostgreSQL) ──────────────────────
# Coller directement l'URL fournie par Neon (postgresql://... ou postgresql+asyncpg://...)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# Connection pool (PostgreSQL uniquement)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300

# ─── Serveur ────────────────────────────────────────────────
PORT=8000

# ─── CORS ───────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ─── Paramètres métiers ─────────────────────────────────────
DEFAULT_GESTATION_DAYS=150
DEFAULT_CURRENCY=FCFA
